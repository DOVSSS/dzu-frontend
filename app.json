{
  "expo": {
    "name": "DZU",
    "slug": "frontend",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
     "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dzu",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.butu.frontend",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8307494a-8560-498d-ba51-18af639c379d"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Мы используем ваши координаты только в момент оформления заказа, чтобы передать курьеру точное место доставки на карте — например, если вы заказываете со двора или парка, где сложно определить адрес текстом, курьер увидит точку на карте и быстрее вас найдёт.",
          "locationAlwaysAndWhenInUsePermission": "Мы используем ваши координаты только в момент оформления заказа, чтобы передать курьеру точное место доставки на карте — например, если вы заказываете со двора или парка, где сложно определить адрес текстом, курьер увидит точку на карте и быстрее вас найдёт."
        }
      ],
      "expo-image",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-font"
    ]
  }
}
